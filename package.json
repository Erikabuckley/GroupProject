{
  "name": "team-project",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test:node": "node --test test/node/*",
    "test:jest": "jest test/jest --verbose --expand",
    "test:jest:watch": "jest test/jest --watch --verbose --expand",
    "test:jest:one": "jest --runTestsByPath --verbose --expand",
    "test:jest:debug": "jest test/jest --runInBand --detectOpenHandles --verbose --expand",
    "test": "npm run test:node && npm run test:jest",
    "postinstall": "npm rebuild sqlite3 --build-from-source"
  },
  "jest": {
    "clearMocks": true,
    "verbose": true,
    "testEnvironment": "node"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "sharp-phash": "^2.2.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "20.x"
  }
}
